{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/nexusadmin",
      "destination": "/register.html"
    },
    {
      "source": "/nexusadmin.html",
      "destination": "/register.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    }
  ]
}
